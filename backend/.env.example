# Use deployment-managed values. Do not commit populated secrets or credentials.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/brandwright_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=REPLACE_WITH_A_LOCAL_STORAGE_USERNAME
MINIO_SECRET_KEY=REPLACE_WITH_A_LOCAL_STORAGE_PASSWORD
LLM_MODE=MOCK
RETRIEVER=memory
EMBEDDING_PROVIDER=fake
REVIEW_ASYNC=false
REVIEW_JOB_TIMEOUT_SECONDS=300
