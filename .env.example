# Set these placeholders in your deployment environment. Do not commit populated secrets.
POSTGRES_USER=brandwright
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=brandwright_db
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Set both flags to true to show demo sign-in. NEXT_PUBLIC_DEMO_MODE is build-time.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

CORS_ORIGINS=http://localhost:3000
MINIO_ROOT_USER=REPLACE_WITH_A_LOCAL_STORAGE_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LOCAL_STORAGE_PASSWORD
BRANDWRIGHT_MODEL_MODE=mock
BRANDWRIGHT_ANTHROPIC_API_KEY=
RETRIEVER=pgvector
EMBEDDING_PROVIDER=fake
REVIEW_ASYNC=false
REVIEW_JOB_TIMEOUT_SECONDS=300
