        "properties": {
          "rule": {
            "additionalProperties": true,
            "type": "object",
            "title": "Rule"
          },
          "decisions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Decisions"
          }
        },
        "type": "object",
        "required": [
          "rule"
        ],
        "title": "ClarificationRequest"
      },
      "DocumentReviewRequest": {
        "properties": {
          "intent": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Intent"
          },
          "content_id": {
            "type": "string",
            "maxLength": 120,
            "title": "Content Id",
            "default": "uploaded-content"
          },
          "version_no": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version No",
            "default": 1
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/RuleInput"
            },
            "type": "array",
            "title": "Rules"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/FactInput"
            },
            "type": "array",
            "title": "Facts"
          },
          "local_only": {
            "type": "boolean",
            "title": "Local Only",
            "default": true
          },
          "confidential_strings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Confidential Strings"
          }
        },
        "type": "object",
        "required": [
          "intent"
        ],
        "title": "DocumentReviewRequest"
      },
      "FactInput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "FactInput"
      },
      "FindingDecisionRequest": {
        "properties": {
          "rule_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Rule Id"
          },
          "action": {
            "type": "string",
            "pattern": "^(accept|edit|dismiss)$",
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 4000,
            "title": "Reason",
            "default": ""
          },
          "edited_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Text"
          },
          "actor_role": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(creator|manager|reviewer|admin)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Role"
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "action"
        ],
        "title": "FindingDecisionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
