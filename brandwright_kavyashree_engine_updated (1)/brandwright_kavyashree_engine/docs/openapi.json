          },
          "version_no": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version No",
            "default": 1
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/RuleInput"
            },
            "type": "array",
            "title": "Rules"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/FactInput"
            },
            "type": "array",
            "title": "Facts"
          },
          "local_only": {
            "type": "boolean",
            "title": "Local Only",
            "default": true
          },
          "confidential_strings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Confidential Strings"
          }
        },
        "type": "object",
        "required": [
          "content",
          "intent"
        ],
        "title": "ReviewRequest"
      },
