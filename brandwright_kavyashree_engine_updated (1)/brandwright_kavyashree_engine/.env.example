# SQLite is used automatically for local development.
# For PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/brandwright
BRANDWRIGHT_DATABASE_URL=sqlite:///./brandwright_review_engine.db
BRANDWRIGHT_MAX_UPLOAD_BYTES=10485760
BRANDWRIGHT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BRANDWRIGHT_MODEL_MODE=mock
BRANDWRIGHT_MODEL_NAME=claude-sonnet-4-5
# Keep mock for offline development. Set to claude only after configuring the API key.
BRANDWRIGHT_ANTHROPIC_API_KEY=
BRANDWRIGHT_LOCAL_ONLY_DEFAULT=true
